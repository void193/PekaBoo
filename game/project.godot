; Engine configuration file.
config_version=5

[application]

config/name="PekaBoo"
config/description="PekaBoo — hide & seek and a cosy chill night for two. Made by RubinBastakoti."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.992, 0.984, 0.937, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Net="*res://scripts/net.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"
Lan="*res://scripts/lan.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]

textures/vram_compression/import_s3tc_bptc=true

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.95, 1)

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1
3d/merge_rasterizer_cell_scale=0.001
